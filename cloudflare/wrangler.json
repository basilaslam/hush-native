{
  "name": "hush-native-room",
  "main": "worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "HushRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HushRoom"
      ]
    }
  ],
  "vars": {
    "DEPLOYMENT_ID": "development"
  }
}